# Dependencias y estado local de wrangler
node_modules
.wrangler

# Simula el correo de Cloudflare Access en pruebas locales: no debe subirse
.dev.vars

.DS_Store

# Salida de herramientas de análisis que corren sobre la carpeta
graphify-out

# Lo que genera supabase/restablecer-clave.mjs: lleva el hash de una clave
